{
  "name": "qr-data-transfer",
  "version": "1.0.1",
  "description": "QRStream — offline QR-code file-transfer PWA (Vite + Preact + TS)",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "tsc": "tsc --noEmit",
    "vitest": "vitest",
    "soak": "vitest run tests/soak",
    "soak:full": "SOAK_FULL=1 vitest run tests/soak",
    "lint": "eslint .",
    "format": "prettier --write .",
    "perf": "vitest run tests/unit/perf.test.ts --disable-console-intercept",
    "perf:e2e": "npx playwright test tests/e2e/perf.spec.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.10.1",
    "@ribpay/qr-code-generator": "^1.0.6",
    "pako": "^3.0.1",
    "preact": "^10.29.7",
    "raptorq": "^1.7.24",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/pako": "^2.0.4",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
